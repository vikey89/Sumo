{
  "name": "sumo-arena",
  "version": "0.1.0",
  "private": true,
  "license": "MIT",
  "type": "module",
  "scripts": {
    "dev": "concurrently -k -n engine,arena -c yellow,cyan \"npm:dev:server\" \"npm:dev:web\"",
    "dev:web": "vite",
    "dev:server": "cargo run --manifest-path server/Cargo.toml",
    "build": "tsc --noEmit && vite build",
    "test": "vitest run",
    "e2e": "playwright test",
    "lint": "eslint .",
    "check": "tsc --noEmit && eslint . && vitest run",
    "preview": "vite preview",
    "build:cli": "npm run build && cargo build --release --manifest-path server/Cargo.toml"
  },
  "dependencies": {
    "@babylonjs/core": "^8.0.0"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.64.1",
    "@types/node": "^26.6.5",
    "concurrently": "^10.0.6",
    "eslint": "^10.13.0",
    "happy-dom": "^21.0.4",
    "typescript": "^5.9.0",
    "typescript-eslint": "^8.72.1",
    "vite": "^8.3.5",
    "vitest": "^5.0.5"
  }
}
